---
import { currentDevelopmentVersion, roadmapNodes } from '../../data/roadmap';

const stageLabel = {
  done: 'Done',
  next: 'Next',
  planned: 'Planned',
} as const;
---

<section class="roadmap-graph" aria-labelledby="roadmap-heading">
  <div class="roadmap-graph__intro">
    <p class="roadmap-graph__eyebrow">Roadmap</p>
    <h2 id="roadmap-heading">The feature path, oldest first.</h2>
    <p>
      This page only tracks user-facing wins: generators, language features, inputs, and output
      formats. Routine fixes and refactors stay in the commit log where they belong.
    </p>
  </div>

  <ol class="roadmap-graph__track" aria-label={`CCL roadmap through ${currentDevelopmentVersion}`}>
    {roadmapNodes.map((node) => (
      <li class={`roadmap-node roadmap-node--${node.stage}`}>
        <div class="roadmap-node__pin" aria-hidden="true">
          <span></span>
        </div>

        <article tabindex="0" aria-labelledby={`roadmap-${node.id}-title`}>
          <div class="roadmap-node__body">
            <p class="roadmap-node__meta">
              <span>{stageLabel[node.stage]}</span>
              {node.release && <span>{node.release}</span>}
            </p>
            <h3 id={`roadmap-${node.id}-title`}>{node.title}</h3>
            <p class="roadmap-node__summary">{node.summary}</p>

            <div class="roadmap-node__details">
              <ul>
                {node.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      </li>
    ))}
  </ol>
</section>

<style>
  .roadmap-graph {
    margin: 1.4rem 0 2.4rem;
    max-width: 100%;
    overflow-x: clip;
  }

  .roadmap-graph__intro {
    max-width: 48rem;
    margin-bottom: 1.6rem;
  }

  .roadmap-graph__eyebrow,
  .roadmap-node__meta {
    color: var(--sl-color-text-accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .roadmap-graph__eyebrow {
    margin: 0 0 0.35rem;
  }

  .roadmap-graph__intro h2 {
    margin: 0;
    font-family: var(--ccl-heading-font);
    font-size: clamp(2rem, 5vw, 3.6rem);
    letter-spacing: 0;
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .roadmap-graph__intro p:last-child {
    color: var(--sl-color-text-muted);
    font-size: 1.04rem;
    line-height: 1.7;
  }

  .roadmap-graph__track {
    --roadmap-spine-width: 4.2rem;
    --roadmap-card-gap: 1.6rem;
    position: relative;
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roadmap-graph__track::before {
    content: "";
    position: absolute;
    top: 2.2rem;
    bottom: 2.2rem;
    left: 50%;
    width: 3px;
    border-radius: 999px;
    background:
      linear-gradient(
        180deg,
        var(--sl-color-text-accent),
        rgba(196, 107, 55, 0.85) 56%,
        var(--sl-color-hairline)
      );
    transform: translateX(-50%);
  }

  .roadmap-node {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--roadmap-spine-width) minmax(0, 1fr);
    align-items: start;
    min-width: 0;
    min-height: 11.4rem;
    padding: 0.35rem 0;
  }

  .roadmap-node::after {
    content: "";
    position: absolute;
    top: 2.55rem;
    left: calc(50% + 1.15rem);
    width: calc(var(--roadmap-card-gap) + 0.65rem);
    height: 2px;
    border-radius: 999px;
    background: var(--sl-color-hairline);
  }

  .roadmap-node:nth-child(odd)::after {
    left: auto;
    right: calc(50% + 1.15rem);
  }

  .roadmap-node article {
    position: relative;
    display: grid;
    grid-column: 3;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.65rem;
    min-width: 0;
    margin-left: var(--roadmap-card-gap);
    padding: 1rem 1.1rem 0.9rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--ccl-radius-md);
    background:
      linear-gradient(135deg, rgba(15, 118, 110, 0.08), transparent 45%),
      var(--sl-color-bg-sidebar);
    box-shadow: 0 16px 40px rgba(15, 20, 18, 0.08);
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .roadmap-node:nth-child(odd) article {
    grid-column: 1;
    margin-right: var(--roadmap-card-gap);
    margin-left: 0;
  }

  .roadmap-node article:hover,
  .roadmap-node article:focus-visible {
    border-color: rgba(15, 118, 110, 0.45);
    box-shadow: 0 24px 58px rgba(15, 20, 18, 0.13);
    transform: translateY(-2px);
    outline: none;
  }

  .roadmap-node--next article {
    border-color: rgba(196, 107, 55, 0.34);
    background:
      linear-gradient(135deg, rgba(196, 107, 55, 0.14), transparent 48%),
      var(--sl-color-bg-sidebar);
  }

  .roadmap-node--planned article {
    background:
      linear-gradient(135deg, rgba(141, 129, 109, 0.1), transparent 48%),
      var(--sl-color-bg-sidebar);
  }

  .roadmap-node__pin {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 1.45rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 4px solid var(--sl-color-bg);
    border-radius: 999px;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-bg);
    box-shadow: 0 12px 26px rgba(15, 20, 18, 0.18);
    transform: translateX(-50%);
  }

  .roadmap-node__pin span {
    display: block;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    background: var(--sl-color-bg);
  }

  .roadmap-node--next .roadmap-node__pin {
    background: #c46b37;
  }

  .roadmap-node--planned .roadmap-node__pin {
    background: var(--sl-color-gray-4);
  }

  .roadmap-node__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
  }

  .roadmap-node__meta span {
    display: inline-flex;
    align-items: center;
    min-height: 1.55rem;
    padding: 0 0.55rem;
    border: 1px solid rgba(15, 118, 110, 0.18);
    border-radius: 999px;
    background: rgba(15, 118, 110, 0.08);
  }

  .roadmap-node--next .roadmap-node__meta span {
    border-color: rgba(196, 107, 55, 0.24);
    background: rgba(196, 107, 55, 0.1);
  }

  .roadmap-node h3 {
    margin: 0;
    font-family: var(--ccl-heading-font);
    font-size: clamp(1.32rem, 3vw, 2rem);
    letter-spacing: 0;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .roadmap-node__summary {
    margin: 0;
    color: var(--sl-color-text-muted);
    font-size: 1rem;
    line-height: 1.62;
    overflow-wrap: anywhere;
  }

  .roadmap-node__details {
    position: absolute;
    z-index: 3;
    top: calc(100% - 0.55rem);
    right: 1.1rem;
    left: 1.1rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid rgba(15, 118, 110, 0.18);
    border-radius: calc(var(--ccl-radius-md) - 4px);
    background: var(--sl-color-bg);
    box-shadow: 0 18px 38px rgba(15, 20, 18, 0.15);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.35rem) scale(0.98);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .roadmap-node article:hover .roadmap-node__details,
  .roadmap-node article:focus-within .roadmap-node__details,
  .roadmap-node article:focus-visible .roadmap-node__details {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .roadmap-node__details ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .roadmap-node__details li {
    color: var(--sl-color-text);
    font-size: 0.9rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .roadmap-graph {
      width: min(100%, calc(100vw - 2.5rem));
      overflow-x: hidden;
    }

    .roadmap-graph__intro {
      max-width: 100%;
    }

    .roadmap-graph__intro h2 {
      max-width: 13ch;
      font-size: 2rem;
    }

    .roadmap-graph__intro p:last-child {
      max-width: 29ch;
      overflow-wrap: anywhere;
    }

    .roadmap-graph__track {
      --roadmap-spine-width: 2.8rem;
      --roadmap-card-gap: 0.9rem;
    }

    .roadmap-graph__track::before {
      left: calc(var(--roadmap-spine-width) / 2);
    }

    .roadmap-node {
      grid-template-columns:
        var(--roadmap-spine-width)
        minmax(0, calc(100vw - var(--roadmap-spine-width) - 7rem));
      min-height: 0;
      padding: 0.55rem 0;
    }

    .roadmap-node::after,
    .roadmap-node:nth-child(odd)::after {
      left: calc(var(--roadmap-spine-width) / 2 + 1.05rem);
      right: auto;
      width: 0.85rem;
    }

    .roadmap-node article,
    .roadmap-node:nth-child(odd) article {
      grid-column: 2;
      min-height: 0;
      width: 100%;
      margin-right: 0;
      margin-left: var(--roadmap-card-gap);
    }

    .roadmap-node h3 {
      font-size: 1.28rem;
    }

    .roadmap-node__summary {
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .roadmap-node__pin {
      left: calc(var(--roadmap-spine-width) / 2);
      width: 2.25rem;
      height: 2.25rem;
    }

    .roadmap-node__details {
      position: static;
      margin-top: 0.8rem;
      padding: 0;
      border: 0;
      background: transparent;
      box-shadow: none;
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .roadmap-node article,
    .roadmap-node__details {
      transition: none;
    }
  }
</style>
